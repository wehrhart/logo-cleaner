# All values optional; defaults are in pipeline/config.py

# Path to the input workbook
#WORKBOOK_PATH=data/Account_Icon_Search_Batch_3.xlsx

# Output filename pattern ({id} is replaced with the workbook ID column).
# Default follows the worked examples (five zeros). Set six zeros if required:
#FILENAME_TEMPLATE=File_{id}_0_0_0_0_0_0.png

# Image rules
#MIN_OUTPUT_SIZE=250
#PREFERRED_OUTPUT_SIZE=500
#PAD_RATIO=0.08

# Decision thresholds
#ACCEPT_THRESHOLD=0.70
#HIFLD_MATCH_THRESHOLD=0.62

# Networking
#CONCURRENCY=8
#HTTP_TIMEOUT=20
#MAX_RETRIES=2
#PER_HOST_DELAY=1.0
#USER_AGENT=Mozilla/5.0 ...

# Optional paid search API key (enables an extra discovery backend if set)
#SERPAPI_KEY=
